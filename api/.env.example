DATABASE_URL=postgres://inbox:inbox@localhost:5432/inbox
PORT=4000
# Generate with: openssl rand -hex 32   (required when NODE_ENV=production)
JWT_SECRET=change-me
# Optional: if set, signup requires this invite code. Set it before going public.
SIGNUP_CODE=

# ---- AI draft replies. Never commit real keys. ----
# mock = fake draft, no account needed. Others: groq (free, no card), gemini (free), anthropic (paid)
AI_PROVIDER=mock
GROQ_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
# Optional for groq/anthropic; REQUIRED for gemini (copy the current free Flash model name from AI Studio)
AI_MODEL=
